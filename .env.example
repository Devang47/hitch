# Required: your OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: default model. Any id from https://openrouter.ai/models — filter by
# "Free" for $0 models (their slugs rotate and are often rate-limited, so pick a
# current one). Shell env overrides this file.
HITCH_MODEL=anthropic/claude-sonnet-4.5

# Optional: max output tokens per turn (default 8192). Lower it if a low-balance
# key returns 402 "requires more credits"; raise it for very large single edits.
HITCH_MAX_TOKENS=8192

# Optional: OpenRouter provider routing as JSON (advanced). Pin a provider,
# disable fallbacks, etc. See https://openrouter.ai/docs/features/provider-routing
# e.g. HITCH_PROVIDER={"only":["morph"],"allow_fallbacks":false}
# HITCH_PROVIDER=
