{
  "name": "@devang47/hitch",
  "version": "0.3.1",
  "description": "A minimal, OpenRouter-native coding agent. pi's spirit — four tools, tiny prompt — plus a permission gate, a live cost meter, and session resume.",
  "type": "module",
  "bin": {
    "hitch": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "check": "biome check src",
    "fix": "biome check --write src",
    "test": "tsc && node --import tsx --test src/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openrouter",
    "coding-agent",
    "cli",
    "llm",
    "agent",
    "harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devang47/hitch.git"
  },
  "homepage": "https://github.com/devang47/hitch#readme",
  "bugs": "https://github.com/devang47/hitch/issues",
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
